flowchart TD
    %% EXPLANATION:
    %% This Finance/Procurement process shows how Accounts Payable resolves invoice discrepancies found during
    %% three-way matching, escalating to Procurement for root-cause investigation and vendor/internal correction
    %% before payment is approved and released by the Finance Manager.

    START(["Invoice Received"])
    subgraph AP["Accounts Payable"]
        direction TB
        MATCH["Match Invoice to PO and Receipt (3-Way Match)"]
        %% R01
        GATE1{"Match Successful?"}
        %% R01
        SUBMIT["Submit for Payment Approval"]
        %% R01
        NOTIFY["Notify Procurement of Discrepancy"]
        %% R01
        RECEIVE["Receive Corrected Documentation"]
        %% R01
    end

    subgraph PROC["Procurement"]
        direction TB
        INVEST["Investigate Discrepancy"]
        %% R02
        GATE2{"Root Cause?"}
        %% R02
        %% [1] start
        VENDOR["Escalate to Vendor for Correction"]
        %% [1] end
        %% R02
        INTERNAL["Correct Internal Receipt Record"]
        %% R02
        CONFIRM["Confirm Correction with Requester"]
        %% R02
    end

    subgraph FM["Finance Manager"]
        direction TB
        APPROVE["Approve and Release Payment"]
        %% R03
        %% ⚡ CHANGED SECTION — added Archive Resolution Record node after payment approval
        ARCHIVE["Archive Resolution Record"]
        %% R03
        %% END CHANGED SECTION
        END(["Payment Released"])
    end

    START --> MATCH
    MATCH --> GATE1
    GATE1 -->|Yes| SUBMIT
    GATE1 -->|No| NOTIFY
    SUBMIT --> APPROVE
    %% ⚡ CHANGED SECTION — rerouted payment approval to pass through new archive step
    APPROVE --> ARCHIVE
    ARCHIVE --> END
    %% END CHANGED SECTION
    NOTIFY --> INVEST
    INVEST --> GATE2
    GATE2 -->|"Vendor error"| VENDOR
    GATE2 -->|"Internal error"| INTERNAL
    VENDOR --> CONFIRM
    INTERNAL --> CONFIRM
    CONFIRM --> RECEIVE
    RECEIVE -->|"Re-match"| MATCH

